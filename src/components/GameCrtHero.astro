---
/**
 * GameCrtHero — signature component for oriz-blog-gaming.
 *
 * Renders a CRT-monitor-bezel hero with scanline overlay, blinking cursor,
 * "PLAYER 1 READY" attract-screen text, and the XP bar. Used only on the
 * homepage — this is the unmistakable gaming identity anchor.
 *
 * No JS required for the static version; animation is CSS-only and
 * respects prefers-reduced-motion.
 */
interface Props {
  postCount: number
  latestTitle?: string
  latestHref?: string
  dateline?: string
}

const { postCount, latestTitle, latestHref, dateline } = Astro.props
---

<div class="crt-bezel" role="img" aria-label="Arcade attract screen">
  <div class="crt-screen">
    <!-- scanline overlay -->
    <div class="crt-scanlines" aria-hidden="true"></div>
    <!-- corner decorations -->
    <span class="corner tl" aria-hidden="true">┌─</span>
    <span class="corner tr" aria-hidden="true">─┐</span>
    <span class="corner bl" aria-hidden="true">└─</span>
    <span class="corner br" aria-hidden="true">─┘</span>

    <div class="crt-content">
      <p class="attract-eyebrow mono">
        <span class="blink" aria-hidden="true">▶</span>
        {dateline ?? 'PLAYER 1 READY'}
      </p>
      <h1 class="attract-title">
        <span class="title-line1">PRESS</span>
        <span class="title-line2 accent">START</span>
      </h1>
      <p class="attract-sub">
        Bench-tested takes on games and gear.<br />
        <span class="muted">What to build, what to play, and how to actually get good.</span>
      </p>

      {latestTitle && latestHref && (
        <a class="now-playing" href={latestHref}>
          <span class="np-label mono">NOW LOADING</span>
          <span class="np-title">{latestTitle}</span>
          <span class="np-arrow" aria-hidden="true">→</span>
        </a>
      )}

      <div class="xp-row" aria-hidden="true">
        <span class="xp-label mono">XP</span>
        <span class="xp-track">
          <span class="xp-fill"></span>
        </span>
        <span class="xp-count mono">{postCount} DROPS</span>
      </div>
    </div>

    <!-- bottom status bar -->
    <div class="crt-status-bar" aria-hidden="true">
      <span class="mono">INSERT COIN</span>
      <span class="mono blink2">●</span>
      <span class="mono">SCROLL TO PLAY</span>
    </div>
  </div>
</div>

<style>
  .crt-bezel {
    position: relative;
    background: #0a0818;
    border-radius: 12px 12px 18px 18px;
    padding: 20px;
    box-shadow:
      0 0 0 3px #1e1838,
      0 0 0 6px #2c2450,
      0 12px 48px color-mix(in oklab, var(--accent) 25%, transparent),
      inset 0 0 60px color-mix(in oklab, var(--paper) 40%, transparent);
    margin-block: clamp(1.5rem, 4vw, 2.5rem) 0;
  }
  .crt-screen {
    position: relative;
    background: var(--paper);
    border-radius: 6px 6px 10px 10px;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    min-height: clamp(280px, 40vw, 440px);
    display: flex;
    flex-direction: column;
  }
  /* CRT scanlines — static, faint */
  .crt-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background-image: repeating-linear-gradient(
      to bottom,
      color-mix(in oklab, var(--paper) 92%, transparent) 0,
      color-mix(in oklab, var(--paper) 92%, transparent) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: multiply;
  }
  .corner {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--rule-strong);
    z-index: 3;
    line-height: 1;
  }
  .tl { top: 10px; left: 12px; }
  .tr { top: 10px; right: 12px; }
  .bl { bottom: 36px; left: 12px; }
  .br { bottom: 36px; right: 12px; }

  .crt-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 3.5rem) clamp(1.5rem, 5vw, 3rem);
    position: relative;
    z-index: 4;
  }

  .attract-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .attract-title {
    font-family: var(--font-pixel);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 0.95;
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .title-line1 { color: var(--ink); }
  .title-line2 {
    color: var(--accent);
    text-shadow:
      0 0 20px color-mix(in oklab, var(--accent) 60%, transparent),
      0.06em 0.06em 0 var(--brand-soft);
  }
  .attract-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 1.75rem;
    max-width: 48ch;
  }
  .muted { color: var(--ink-mute); }

  .now-playing {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--paper-2);
    border: 1px solid var(--rule-strong);
    border-left: 3px solid var(--accent);
    padding: 0.625rem 1rem;
    text-decoration: none;
    color: var(--ink);
    max-width: fit-content;
    margin-bottom: 1.5rem;
    transition: border-color var(--dur-fast, 120ms) ease, background var(--dur-fast, 120ms) ease;
  }
  .now-playing:hover {
    border-color: var(--accent);
    background: var(--brand-soft);
  }
  .np-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--coin);
    white-space: nowrap;
  }
  .np-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 36ch;
  }
  .np-arrow { color: var(--accent); }

  .xp-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .xp-label, .xp-count {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .xp-label { color: var(--coin); }
  .xp-count { color: var(--ink-mute); }
  .xp-track {
    position: relative;
    flex: 0 0 160px;
    height: 10px;
    background: var(--paper-2);
    border: 1px solid var(--rule-strong);
    background-image: repeating-linear-gradient(
      to right,
      transparent 0, transparent 11px,
      var(--paper) 11px, var(--paper) 13px
    );
  }
  .xp-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 68%;
    background: var(--accent);
    background-image: repeating-linear-gradient(
      to right,
      var(--accent) 0, var(--accent) 11px,
      color-mix(in oklab, var(--accent) 30%, transparent) 11px,
      color-mix(in oklab, var(--accent) 30%, transparent) 13px
    );
    box-shadow: 0 0 8px color-mix(in oklab, var(--accent) 50%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .xp-fill { animation: xpload 1s var(--ease-out, ease-out) both 200ms; }
  }
  @keyframes xpload { from { width: 0; } to { width: 68%; } }

  /* status bar at bottom */
  .crt-status-bar {
    position: relative;
    z-index: 4;
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
    padding: 0.375rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* blink animations */
  @media (prefers-reduced-motion: no-preference) {
    .blink { animation: blink 1.1s step-end infinite; }
    .blink2 { animation: blink 0.8s step-end infinite 0.4s; color: var(--accent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .blink, .blink2 { opacity: 1; }
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* mobile: tighten */
  @media (max-width: 480px) {
    .crt-bezel { padding: 10px; border-radius: 8px 8px 12px 12px; }
    .title-line2 { font-size: clamp(2rem, 12vw, 3rem); }
    .xp-track { flex: 0 0 80px; }
  }
</style>
