---
/**
 * / — oriz-blog-gaming homepage ("Arcade Cabinet").
 *
 * Structure (gaming-native, not newspaper):
 *   1. GameCrtHero   — CRT bezel attract screen (signature module)
 *   2. SELECT GAME   — cartridge tile grid (most recent posts)
 *   3. CAMPAIGNS     — in-progress series as progress bars
 *   4. SELECT GENRE  — category selector as arcade button row
 *
 * No generic hero+card-grid. Every element is cartridge/CRT/arcade-native.
 */
import GameCrtHero from '~/components/GameCrtHero.astro'
import SeriesSpine from '~/components/SeriesSpine.astro'
import CartridgeCard from '~/components/blog/CartridgeCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  slugifyTag,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const gridPosts = allPosts.slice(0, 9)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({ name: series, slug: slugifyTag(series), total, published: count, current: count, latest })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const now = new Date()
const dateline = now.toLocaleDateString('en-US', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).toUpperCase()

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="oriz / arcade"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="container-page">

    {/* ── 1. CRT HERO (signature module) ──────────────────────────── */}
    <GameCrtHero
      postCount={allPosts.length}
      latestTitle={lead?.data.title}
      latestHref={lead ? `/blog/${lead.id}` : undefined}
      dateline={`STAGE SELECT · ${dateline}`}
    />

    {/* ── 2. SELECT GAME — cartridge grid ─────────────────────────── */}
    <section class="zone zone-grid" aria-labelledby="z-grid">
      <header class="zone-head">
        <h2 id="z-grid" class="zone-label mono">
          <span class="zone-arrow" aria-hidden="true">▶</span>
          Select Game
        </h2>
        <a class="zone-more mono" href="/blog/">View all {allPosts.length} →</a>
      </header>
      {gridPosts.length === 0 ? (
        <p class="empty-state">No drops yet — first one loads soon.</p>
      ) : (
        <ul class="cartridge-grid" role="list">
          {gridPosts.map((p, i) => (
            <li>
              <CartridgeCard post={p} index={i} />
            </li>
          ))}
        </ul>
      )}
    </section>

    {/* ── 3. CAMPAIGNS — in-progress series ───────────────────────── */}
    {inProgress.length > 0 && (
      <section class="zone zone-campaigns" aria-labelledby="z-campaigns">
        <header class="zone-head">
          <h2 id="z-campaigns" class="zone-label mono">
            <span class="zone-arrow" aria-hidden="true">▶</span>
            Campaigns
          </h2>
          <a class="zone-more mono" href="/series/">All series →</a>
        </header>
        <ul class="campaign-list">
          {inProgress.map((s) => (
            <li class="campaign-row">
              <a class="campaign-link" href={`/series/${s.slug}/`}>
                <span class="campaign-name">{s.name}</span>
                <span class="campaign-progress">
                  <SeriesSpine
                    total={s.total}
                    published={s.published}
                    current={s.current}
                    size="md"
                  />
                </span>
                <span class="campaign-meta mono">{s.published}/{s.total} parts</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── 4. SELECT GENRE — category arcade buttons ───────────────── */}
    {cats.length > 0 && (
      <section class="zone zone-genres" aria-labelledby="z-genres">
        <header class="zone-head">
          <h2 id="z-genres" class="zone-label mono">
            <span class="zone-arrow" aria-hidden="true">▶</span>
            Select Genre
          </h2>
        </header>
        <ul class="genre-btns" role="list">
          {cats.map((c) => (
            <li>
              <a class="genre-btn" href={`/categories/${slugifyTag(c.category)}/`}>
                <span class="genre-btn-name">{c.category}</span>
                <span class="genre-btn-count mono">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .container-page {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-bottom: 4rem;
  }

  /* ── zones ──────────────────────────────────────────────────────── */
  .zone {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .zone-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.625rem;
    border-bottom: 2px solid var(--accent);
  }
  .zone-label {
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .zone-arrow { font-size: 10px; }
  .zone-more {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    white-space: nowrap;
  }
  .zone-more:hover { color: var(--accent); }

  /* ── cartridge grid ─────────────────────────────────────────────── */
  .cartridge-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }

  .empty-state {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
  }

  /* ── campaigns (series) ─────────────────────────────────────────── */
  .campaign-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .campaign-row {
    border-bottom: 1px solid var(--rule);
  }
  .campaign-row:first-child {
    border-top: 1px solid var(--rule);
  }
  .campaign-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 1.25rem;
    align-items: center;
    padding-block: 0.875rem;
    color: var(--ink);
    text-decoration: none;
    padding-left: 0.75rem;
    margin-left: -0.75rem;
    border-left: 3px solid transparent;
    transition: border-color var(--dur-fast, 120ms) ease;
  }
  .campaign-link:hover {
    border-left-color: var(--accent);
  }
  .campaign-link:hover .campaign-name { color: var(--accent); }
  .campaign-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .campaign-progress { display: inline-flex; }
  .campaign-meta {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .campaign-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name meta' 'prog prog';
      row-gap: 0.375rem;
    }
    .campaign-name { grid-area: name; }
    .campaign-meta { grid-area: meta; }
    .campaign-progress { grid-area: prog; }
  }

  /* ── genre buttons ──────────────────────────────────────────────── */
  .genre-btns {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .genre-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    background: var(--paper-2);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      background var(--dur-fast, 120ms) ease,
      border-color var(--dur-fast, 120ms) ease,
      color var(--dur-fast, 120ms) ease;
  }
  .genre-btn:hover {
    background: var(--brand-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .genre-btn-count {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    background: var(--paper);
    padding: 0.1rem 0.375rem;
    border: 1px solid var(--rule);
  }
  .genre-btn:hover .genre-btn-count {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
