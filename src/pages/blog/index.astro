---
import CartridgeCard from '~/components/blog/CartridgeCard.astro'
/**
 * /blog — page 1 of the paginated blog index.
 * Pages 2+ live at /blog/page/[page] (see ./page/[page].astro).
 *
 * Layout: genre filter strip, then a cartridge grid (gaming-native card format).
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getAllCategories, getPublishedPosts, slugifyTag } from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const PAGE_SIZE = 12

const allPosts = await getPublishedPosts()
const categories = await getAllCategories()
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE))
const posts = allPosts.slice(0, PAGE_SIZE)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog — ${SITE_CONFIG.title}`,
  url: new URL('/blog/', SITE_CONFIG.url).toString(),
  description: 'Writing on software, AI agents, finance tooling, and the tools I build at oriz.in.',
  author: {
    '@type': 'Person',
    name: SITE_CONFIG.author.name,
    url: SITE_CONFIG.author.url,
  },
}
---

<BaseLayout
  title="Blog"
  description="Writing on software, AI agents, finance tooling, and the tools I build."
  jsonLd={jsonLd}
>
  <div class="container-page section">
    <header class="blog-head">
      <p class="blog-kicker mono">Game log</p>
      <h1>Drops</h1>
      <p class="blog-lede">
        Writing on games, gear, and getting good.
      </p>
    </header>

    {categories.length > 0 && (
      <nav class="desk-strip mono" aria-label="Filter by genre">
        <a class="desk is-active" href="/blog/">All</a>
        {categories.map((c) => (
          <a class="desk" href={`/categories/${slugifyTag(c)}/`}>{c}</a>
        ))}
      </nav>
    )}

    {posts.length === 0 ? (
      <p class="muted">No drops yet — first one loads soon.</p>
    ) : (
      <ul class="cart-grid" role="list">
        {posts.map((p, i) => (
          <li>
            <CartridgeCard post={p} index={i} />
          </li>
        ))}
      </ul>
    )}

    {totalPages > 1 && (
      <nav class="pager mono" aria-label="Pagination">
        <span class="pager-info">Page 1 of {totalPages}</span>
        <a class="pager-link" href="/blog/page/2/" rel="next">Next →</a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .container-page { max-width: 1100px; }
  .blog-head {
    padding-block: clamp(2rem, 5vw, 3rem) 1.25rem;
  }
  .blog-kicker {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .blog-head h1 {
    font-family: var(--font-pixel);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin: 0;
  }
  .blog-lede {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    margin: 0.75rem 0 0;
    max-width: 56ch;
  }
  .desk-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--accent);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .desk {
    color: var(--ink-mute);
    text-decoration: none;
    padding: 0.25rem 0.625rem;
    border: 1px solid transparent;
  }
  .desk:hover { color: var(--accent); border-color: var(--accent); }
  .desk.is-active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--brand-soft);
  }
  .cart-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }
  .pager {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 12px;
  }
  .pager-info {
    color: var(--ink-mute);
    letter-spacing: 0.06em;
  }
  .pager-link {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--rule);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 11px;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-2);
  }
  .pager-link:hover { border-color: var(--accent); color: var(--accent); background: var(--brand-soft); }
  .muted { color: var(--ink-mute); font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.1em; }
  .section { padding-block: 0 3rem; }
</style>
